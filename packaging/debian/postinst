#!/bin/sh
set -eu

if ! getent group personenzaehler >/dev/null; then
  addgroup --system personenzaehler >/dev/null
fi
if ! getent passwd personenzaehler >/dev/null; then
  adduser --system --ingroup personenzaehler --home /var/lib/personenzaehler --no-create-home --disabled-login personenzaehler >/dev/null
fi
if getent group video >/dev/null; then
  adduser personenzaehler video >/dev/null 2>&1 || true
fi
install -d -o personenzaehler -g personenzaehler -m 0755 /var/lib/personenzaehler /var/lib/personenzaehler/models
install -d -o personenzaehler -g personenzaehler -m 0750 /var/cache/personenzaehler /var/log/personenzaehler
install -d -o root -g personenzaehler -m 0755 /etc/personenzaehler

if [ ! -f /etc/personenzaehler/api.env ]; then
  /usr/bin/python3 - <<'PY' > /etc/personenzaehler/api.env
import base64
import secrets
for name in ("VIEWER", "OPERATOR", "ADMIN"):
    print(f"VISITOR_COUNTER_{name}_TOKEN={secrets.token_urlsafe(36)}")
print("VISITOR_COUNTER_DATA_KEY=" + base64.urlsafe_b64encode(secrets.token_bytes(32)).decode("ascii"))
PY
fi
chown root:personenzaehler /etc/personenzaehler/api.env
chmod 0640 /etc/personenzaehler/api.env
chown root:personenzaehler /etc/personenzaehler/config.yaml
chmod 0644 /etc/personenzaehler/config.yaml

systemctl daemon-reload >/dev/null 2>&1 || true
update-desktop-database >/dev/null 2>&1 || true
update-mime-database /usr/share/mime >/dev/null 2>&1 || true
exit 0
