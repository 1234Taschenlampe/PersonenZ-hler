[Unit]
Description=PersonenZähler production counter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=personenzaehler
Group=personenzaehler
SupplementaryGroups=video
EnvironmentFile=-/etc/personenzaehler/api.env
Environment=VISITOR_COUNTER_LICENSE_REQUIRED=1
Environment=VISITOR_COUNTER_LICENSE_ONLINE_REQUIRED=0
ExecStart=/usr/bin/personenzaehler-service
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
StateDirectory=personenzaehler
CacheDirectory=personenzaehler
LogsDirectory=personenzaehler
ReadWritePaths=/var/lib/personenzaehler /var/cache/personenzaehler /var/log/personenzaehler
UMask=0027

[Install]
WantedBy=multi-user.target
